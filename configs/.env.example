# Hugging Face API Token
# Get your token from: https://huggingface.co/settings/tokens
# Needs WRITE scope to upload artifacts; READ is enough to download them.
HF_TOKEN=your_huggingface_token_here

# Hugging Face dataset repo holding the large artifacts (models, results, NLP data).
# See README > Data & Artifacts. Format: <namespace>/<repo-name>
HF_DATASET_REPO=Theosdoor/ghost-marks-artifacts
